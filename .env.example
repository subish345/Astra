# ASTRA-EA Environment Configuration
# Copy to .env to override local operational settings

# Standard Directory Layout
ASTRA_DATA_DIR=data
ASTRA_DATABASE_PATH=storage/database/astra.db
ASTRA_LOG_LEVEL=INFO

# Network & Streaming Ports (Local Air-Gapped Ports)
ASTRA_STREAM_PORT=8554
ASTRA_EVENTS_PORT=8765
ASTRA_BIND_HOST=127.0.0.1

# Camera & Perception Defaults
ASTRA_DEFAULT_CAMERA=0
ASTRA_CAMERA_PROFILE=view_left
ASTRA_DEPLOYMENT_PROFILE=demo

# Telemetry & Retention Policies
ASTRA_MAX_STORAGE_GB=50.0
ASTRA_MIN_FREE_GB=2.0
ASTRA_VIDEO_RETENTION_DAYS=7
